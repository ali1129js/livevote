# Copy to .env if you like (the server reads real environment variables; no dotenv dependency).
PORT=3001
# Comma-separated exact origins allowed by CORS / Socket.IO. REQUIRED when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the server (Render: 1). 0 = never trust X-Forwarded-For.
TRUST_PROXY=0
# Persistent storage (optional). Unset/empty => in-memory store: polls are lost on restart or Render sleep.
# Use a Postgres connection string, e.g. a free Neon project (https://console.neon.tech/signup, no card).
# Copy it from Neon's "Connect" dialog (the pooled "-pooler" host is fine). It contains a password:
# keep it in your own untracked .env or in Render's dashboard, never commit it.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
#
# Only for running the store tests against a real Postgres (use a throwaway DB/branch, tables are prefixed lvtest_):
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/livevote_test
# Optional rate-limit overrides
# RATE_LIMIT_CREATE=10      # polls per IP per 10 minutes
# RATE_LIMIT_JOINS=60       # poll joins per IP per minute
# RATE_LIMIT_EVENTS=30      # socket events per connection per 10 seconds
