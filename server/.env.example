# Copy to .env if you like (the server reads real environment variables; no dotenv dependency).
PORT=3001
# Comma-separated exact origins allowed by CORS / Socket.IO. REQUIRED when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the server (Render: 1). 0 = never trust X-Forwarded-For.
TRUST_PROXY=0
# Optional rate-limit overrides
# RATE_LIMIT_CREATE=10      # polls per IP per 10 minutes
# RATE_LIMIT_JOINS=60       # poll joins per IP per minute
# RATE_LIMIT_EVENTS=30      # socket events per connection per 10 seconds
